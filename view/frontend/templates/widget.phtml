<?php
/** @var \Meetanshi\CookieNotice\Block\CookieNotice $block */
/** @var \Magento\Framework\Escaper $escaper */
?>
<?php if ($block->enableDisable()): ?>
    <?php
    $width = ($block->getType() == 'v-bar') ? '93%' : 'auto';
    $fontFamily = $block->headerTextFontFamily();
    $fontFamily = str_replace('+', ' ', $fontFamily);
    $fontFamily = "'" . $fontFamily . "'";
    $bgColor = $escaper->escapeHtmlAttr($block->headerBackgroundColor());
    $fontColor = $escaper->escapeHtmlAttr($block->headerFontColor());
    $textAlign = $escaper->escapeHtmlAttr($block->modelTextAlign());
    $type = $escaper->escapeHtmlAttr($block->getType());
    $position = $escaper->escapeHtmlAttr(
        ($block->getType() == 'v-bar')
            ? $block->getBarPosition()
            : $block->getBoxPosition()
    );
    ?>
<div class="cookie-div">
    <?php
    $borderStyle = '';
    if ($block->modelBorder()) {
        $borderStyle = 'border-color:'
            . $escaper->escapeHtmlAttr($block->modelBorderColor());
        if ($block->headerBottomBorder()) {
            $borderStyle .= ';border-bottom-color:'
                . $escaper->escapeHtmlAttr(
                    $block->headerBottomBorderColor()
                );
        }
        if ($block->containerTopBorder()) {
            $borderStyle .= ';border-top-color:'
                . $escaper->escapeHtmlAttr(
                    $block->containerTopBorderColor()
                );
        }
    } else {
        $borderStyle = 'border:0px';
    }
    $containerStyle = 'box-shadow:0px 2px 5px 0px rgba(0,0,0,0.47);'
        . 'display:none;'
        . 'text-align:' . $textAlign . ';'
        . 'background-color:' . $bgColor . ';'
        . 'color:' . $fontColor . ';'
        . $borderStyle;
    ?>
    <div id="m-cookienotice"
         class="<?= /* @noEscape */ $type ?> <?= /* @noEscape */ $position ?>"
         style="<?= /* @noEscape */ $containerStyle ?>;">
        <?php
        $titleSize = $escaper->escapeHtmlAttr(
            $block->modelTitleFontSize()
        );
        $titleColor = $escaper->escapeHtmlAttr(
            $block->modelTitleColor()
        );
        $titleFont = $escaper->escapeHtmlAttr(
            $block->headerTextFontFamily()
        );
        $titleStyle = 'font-weight:bold;'
            . 'width:' . $width . ';'
            . 'font-size:' . $titleSize . 'px;'
            . 'color:' . $titleColor . ';'
            . 'font-family:' . $titleFont;
        $acceptBg = $escaper->escapeHtmlAttr(
            $block->acceptButtonBackgroundColor()
        );
        ?>
        <div class="m-message title"
             style="<?= /* @noEscape */ $titleStyle ?>">
            <span class="titlecookie"
                  style="border-bottom:2px solid <?= /* @noEscape */ $acceptBg ?>;">
            <?php if ($block->getShow() == 'default'): ?>
                <?= /* @noEscape */ __('Cookies and Privacy'); ?>
            <?php else: ?>
                <?= /* @noEscape */ $escaper->escapeHtml($block->modelTitle()) ?>
            <?php endif; ?>
            </span>
        </div>
        <?php
        $msgSize = $escaper->escapeHtmlAttr($block->modelMessageSize());
        $msgStyle = 'width:' . $width . ';'
            . 'font-size:' . $msgSize . 'px;'
            . 'font-family:' . $fontFamily;
        ?>
        <div id="message-custom-css" class="m-message custom-css"
             style="<?= /* @noEscape */ $msgStyle ?>">
            <?php if ($block->getShow() == 'default'): ?>
                <?= /* @noEscape */ __('This website use cookies to ensure you get the best user experience on our website.'); ?>
            <?php else: ?>
                <?= /* @noEscape */ $escaper->escapeHtml($block->getCustomMessage()) ?>
            <?php endif; ?>
        </div>
        <div id="action-custom-css" class="m-actions custom-css">
            <?php
            $acceptStyle = 'background-color:'
                . $acceptBg . ';color:'
                . $escaper->escapeHtmlAttr($block->acceptButtonColor());
            ?>
            <a href="javascript:cookieNoticeAccept();"
               class="m-button m-accept"
               style="<?= /* @noEscape */ $acceptStyle ?>">
                <?php if ($block->getShow() == 'default'): ?>
                    <?= /* @noEscape */ __('Accept'); ?>
                <?php else: ?>
                    <?= /* @noEscape */ $escaper->escapeHtml($block->getCustomAccept()) ?>
                <?php endif; ?>
            </a>
            <?php
            $closeStyle = 'background-color:'
                . $escaper->escapeHtmlAttr($block->closeButtonBackgroundColor())
                . ';color:'
                . $escaper->escapeHtmlAttr($block->closeButtonColor());
            ?>
            <a href="javascript:cookieClose();"
               class="m-button m-decline"
               style="<?= /* @noEscape */ $closeStyle ?>">
                <?php if ($block->getShow() == 'default'): ?>
                    <?= /* @noEscape */ __('Decline'); ?>
                <?php else: ?>
                    <?= /* @noEscape */ $escaper->escapeHtml($block->getCustomDecline()) ?>
                <?php endif; ?>
            </a>
            <?php
            $policyUrl = $escaper->escapeUrl(
                $block->getUrls() . $block->cmsPage()
            );
            $policyTarget = $escaper->escapeHtmlAttr($block->newTab());
            $policyStyle = 'background-color:'
                . $escaper->escapeHtmlAttr($block->policyBackgroundColor())
                . ';color:'
                . $escaper->escapeHtmlAttr($block->privacyPolicyColor());
            ?>
            <a href="<?= /* @noEscape */ $policyUrl ?>"
               target="<?= /* @noEscape */ $policyTarget ?>"
               class="m-button"
               style="<?= /* @noEscape */ $policyStyle ?>">
                <?php if ($block->getShow() == 'default'): ?>
                    <?= /* @noEscape */ __("Read our Privacy Policy"); ?>
                <?php else: ?>
                    <?= /* @noEscape */ $escaper->escapeHtml($block->getCustomMoreInfo()); ?>
                <?php endif; ?>
            </a>
        </div>
    </div>
</div>
    <div id="v-badge" class="v-badge"
         onClick="showDiv()" style="display:none">
        Cookie Settings
    </div>
    <script>
        var behaviour = <?= /* @noEscape */ (int)$block->getBehaviour() ?>;
        var onScroll = '<?= $escaper->escapeJs($block->onscroll()) ?>';
        var expire = '<?= $escaper->escapeJs($block->getAutoExpire()) ?>';
        if (expire === 0 || expire === '0') {
            expire = 1;
        } else {
            expire = <?= /* @noEscape */ (int)$block->getAutoExpire() ?>;
        }

        if (onScroll === 1 || onScroll === '1') {
            window.onscroll = function () {
                if (!jQuery.cookie('cookienotice')
                    || jQuery.cookie('cookienotice') === '0'
                ) {
                    custom();
                }
            };
        }

        function custom() {
            var el = document.getElementById('m-cookienotice');
            if (el.style.display = 'block') {
                if (behaviour) {
                    var d = new Date();
                    d.setTime(d.getTime()
                        + (behaviour + expire * 24 * 60 * 60 * 1000));
                    var expires = "expires=" + d.toUTCString();
                }
                if (document.body.scrollTop > 150
                    || document.documentElement.scrollTop > 150
                ) {
                    document.cookie = "cookienotice=true;"
                        + expires + ";path=/";
                    el.style.display = 'none';
                }
            }
        }

        function showDiv() {
            document.getElementById('m-cookienotice').style.display = "block";
            document.getElementById('v-badge').style.display = 'none';
            <?php if ($block->getAutohide()): ?>
            var hideDelay = <?= /* @noEscape */ (int)$block->getAutohide() * 1000 ?>;
            setTimeout(function () {
                document.getElementById('m-cookienotice').style.display = 'none';
                document.getElementById('v-badge').style.display = 'block';
            }, hideDelay);
            <?php endif; ?>
        }

        function cookieClose() {
            if (behaviour) {
                var d = new Date();
                d.setTime(d.getTime()
                    + (behaviour + expire * 24 * 60 * 60 * 1000));
                var expires = "expires=" + d.toUTCString();
            }
            document.cookie = "cookienotice=0;" + expires + ";path=/";
            document.getElementById('v-badge').style.display = 'block';
            document.getElementById('m-cookienotice').style.display = 'none';
        }

        function cookieNoticeAccept() {
            if (behaviour) {
                var d = new Date();
                d.setTime(d.getTime()
                    + (behaviour + expire * 24 * 60 * 60 * 1000));
                var expires = "expires=" + d.toUTCString();
            }
            document.cookie = "cookienotice=true;" + expires + ";path=/";
            document.getElementById('m-cookienotice').style.display = 'none';
        }

        require([
            'jquery',
            'mage/cookies'
        ], function ($) {
            if ($.cookie('cookienotice') === '0'
                || $.cookie('cookienotice') === 0
            ) {
                document.getElementById('v-badge').style.display = 'block';
            }
            if (!$.cookie('cookienotice')) {
                document.getElementById('m-cookienotice').style.display = 'block';
            }
        });

        <?php if ($block->getAutohide()): ?>
        var autoHideDelay = <?= /* @noEscape */ (int)$block->getAutohide() * 1000 ?>;
        setTimeout(function () {
            document.getElementById('m-cookienotice').style.display = 'none';
            document.getElementById('v-badge').style.display = 'block';
        }, autoHideDelay);
        <?php endif; ?>
        <?php if ($block->getAutoAccept()): ?>
        var autoAcceptDelay = <?= /* @noEscape */ (int)$block->getAutoAccept() * 1000 ?>;
        setTimeout(function () {
            cookieNoticeAccept();
        }, autoAcceptDelay);
        <?php endif; ?>
    </script>

<?php endif; ?>